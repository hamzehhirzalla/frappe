CUSTOM_IMAGE=alhorani-frappe
CUSTOM_TAG=2026-09-14-helpdesk
ERPNEXT_VERSION=v16.34.2
PULL_POLICY=missing
RESTART_POLICY=unless-stopped
DB_PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD
ADMIN_PASSWORD=GENERATE_A_DIFFERENT_ADMINISTRATOR_PASSWORD
HTTP_PUBLISH_PORT=127.0.0.1:8080
FRAPPE_SITE_NAME_HEADER=frappe.localhost
FRAPPE_SITE_URL=http://localhost:8080
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Optional server HTTPS. Store certificates outside the repository, readable
# by the frontend container's UID 1000. Enable through manage.sh on Linux.
FRAPPE_TLS_ENABLED=0
# HTTPS_PUBLISH_PORT=443
# FRAPPE_TLS_CERT_FILE=/home/ubuntu/.local/share/frappe-tls/fullchain.pem
# FRAPPE_TLS_KEY_FILE=/home/ubuntu/.local/share/frappe-tls/privkey.pem
